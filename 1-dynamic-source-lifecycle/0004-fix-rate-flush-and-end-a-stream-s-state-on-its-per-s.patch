From 54df17de881b030e98f89d4235c5b3b6a505d7e8 Mon Sep 17 00:00:00 2001
From: deepx-yjsong <yjsong@deepx.ai>
Date: Mon, 28 Sep 2026 17:54:44 +0900
Subject: [PATCH 04/10] fix(rate): flush and end a stream's state on its
 per-stream EOS

dxrate kept each stream's held frame and timeline until a global EOS or
flush. On a per-stream EOS the ending stream's last frame was never pushed,
and a source reusing the stream id received one frame of the previous
source before its own.

On the wrapped per-stream EOS, flush that stream as a global EOS would and
drop its state. The flush logic is shared with the global EOS path.

Test: the ending stream's held frame is flushed before its EOS; the next
source on the id gets none of the previous source's frames (before: 1).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 gst-dxstream-plugin/src/gst-dxrate.cpp        | 40 +++++----
 .../transform/test_dxrate_per_stream_eos.cpp  | 84 +++++++++++++++++++
 2 files changed, 109 insertions(+), 15 deletions(-)
 create mode 100644 test/base/element/transform/test_dxrate_per_stream_eos.cpp

diff --git a/gst-dxstream-plugin/src/gst-dxrate.cpp b/gst-dxstream-plugin/src/gst-dxrate.cpp
index 10d63bc..744622b 100644
--- a/gst-dxstream-plugin/src/gst-dxrate.cpp
+++ b/gst-dxstream-plugin/src/gst-dxrate.cpp
@@ -381,6 +381,20 @@ static void apply_segment(GstDxRate *self, RateStreamState &st,
     gst_segment_copy_into(&segment, &st.segment);
 }
 
+// Push what a stream still holds before its EOS goes downstream.
+static void flush_at_eos(GstDxRate *self, RateStreamState &st) {
+    if (GST_CLOCK_TIME_IS_VALID(st.segment.stop)) {
+        flush_loop(self, st, st.segment.stop);
+    } else if (st.prevbuf) {
+        if (GST_BUFFER_DURATION_IS_VALID(st.prevbuf)) {
+            GstClockTime end_ts = st.next_ts + GST_BUFFER_DURATION(st.prevbuf);
+            flush_loop(self, st, end_ts);
+        } else {
+            gst_dxrate_flush_prev(self, st, FALSE, GST_CLOCK_TIME_NONE);
+        }
+    }
+}
+
 static gboolean gst_dxrate_sink_event(GstBaseTransform *trans,
                                       GstEvent *event) {
     GstDxRate *self = GST_DXRATE(trans);
@@ -391,7 +405,15 @@ static gboolean gst_dxrate_sink_event(GstBaseTransform *trans,
     if (dx_event_is_wrapped_downstream(event)) {
         gint sid = -1;
         GstEvent *inner = dx_event_peek_inner(event, &sid);
-        if (inner && GST_EVENT_TYPE(inner) == GST_EVENT_SEGMENT) {
+        if (inner && GST_EVENT_TYPE(inner) == GST_EVENT_EOS) {
+            // The stream ended: flush it, then drop its state so a source
+            // reusing the stream id does not continue from it.
+            auto it = streams_map(self).find(sid >= 0 ? sid : 0);
+            if (it != streams_map(self).end()) {
+                flush_at_eos(self, it->second);
+                streams_map(self).erase(it);
+            }
+        } else if (inner && GST_EVENT_TYPE(inner) == GST_EVENT_SEGMENT) {
             GstSegment segment;
             gst_event_copy_segment(inner, &segment);
             if (segment.format == GST_FORMAT_TIME) {
@@ -432,20 +454,8 @@ static gboolean gst_dxrate_sink_event(GstBaseTransform *trans,
     }
     case GST_EVENT_SEGMENT_DONE:
     case GST_EVENT_EOS: {
-        for (auto &kv : streams_map(self)) {
-            RateStreamState &st = kv.second;
-            if (GST_CLOCK_TIME_IS_VALID(st.segment.stop)) {
-                flush_loop(self, st, st.segment.stop);
-            } else if (st.prevbuf) {
-                if (GST_BUFFER_DURATION_IS_VALID(st.prevbuf)) {
-                    GstClockTime end_ts =
-                        st.next_ts + GST_BUFFER_DURATION(st.prevbuf);
-                    flush_loop(self, st, end_ts);
-                } else {
-                    gst_dxrate_flush_prev(self, st, FALSE, GST_CLOCK_TIME_NONE);
-                }
-            }
-        }
+        for (auto &kv : streams_map(self))
+            flush_at_eos(self, kv.second);
         break;
     }
     case GST_EVENT_FLUSH_STOP:
diff --git a/test/base/element/transform/test_dxrate_per_stream_eos.cpp b/test/base/element/transform/test_dxrate_per_stream_eos.cpp
new file mode 100644
index 0000000..e5d8a6c
--- /dev/null
+++ b/test/base/element/transform/test_dxrate_per_stream_eos.cpp
@@ -0,0 +1,84 @@
+// dxrate — a per-stream EOS flushes and ends that stream's state
+// The ending stream's held frame goes out before its EOS; a source reusing
+// the stream id never receives the previous source's frames.
+
+#include <gst/check/gstcheck.h>
+#include <gst/check/gstharness.h>
+#include <gst/gst.h>
+#include "harness_helpers.hpp"
+#include "meta_helpers.hpp"
+#include "utils.hpp"
+
+using namespace dxtest;
+
+static const guint8 OLD_PX = 0xAA;
+static const guint8 NEW_PX = 0x55;
+
+static void start_stream(GstHarness *h, int sid) {
+    GstCaps *c = gst_caps_from_string(
+        "video/x-raw,format=RGB,width=4,height=4,framerate=30/1");
+    gst_harness_push_event(h, dx_event_wrap_downstream(sid, gst_event_new_caps(c)));
+    gst_caps_unref(c);
+    GstSegment seg;
+    gst_segment_init(&seg, GST_FORMAT_TIME);
+    gst_harness_push_event(h, dx_event_wrap_downstream(sid, gst_event_new_segment(&seg)));
+}
+
+static void push_frames(GstHarness *h, int sid, GstClockTime start, int n,
+                        guint8 px) {
+    for (int i = 0; i < n; i++) {
+        GstBuffer *b = gst_harness_create_buffer(h, 4 * 4 * 3);
+        gst_buffer_memset(b, 0, px, 4 * 4 * 3);
+        GST_BUFFER_PTS(b) = start + i * GST_SECOND / 30;
+        GST_BUFFER_DURATION(b) = GST_SECOND / 30;
+        make_frame_meta(b, sid, 4, 4);
+        gst_harness_push(h, b);
+    }
+}
+
+// Counts frames by source (first pixel).
+static void drain(GstHarness *h, int *old_n, int *new_n) {
+    *old_n = *new_n = 0;
+    while (GstBuffer *o = gst_harness_try_pull(h)) {
+        guint8 px = 0;
+        gst_buffer_extract(o, 0, &px, 1);
+        if (px == OLD_PX) (*old_n)++;
+        else if (px == NEW_PX) (*new_n)++;
+        gst_buffer_unref(o);
+    }
+}
+
+GST_START_TEST(per_stream_eos_flushes_and_ends_the_stream) {
+    GstHarness *h = gst_harness_new_parse("dxrate framerate=10");
+    gst_harness_set_src_caps_str(
+        h, "video/x-raw,format=RGB,width=4,height=4,framerate=30/1");
+    int old_n, new_n;
+
+    start_stream(h, 1);
+    push_frames(h, 1, 0, 10, OLD_PX);
+    drain(h, &old_n, &new_n);
+
+    gst_harness_push_event(h, dx_event_wrap_downstream(1, gst_event_new_eos()));
+    drain(h, &old_n, &new_n);
+    fail_unless(old_n >= 1, "the ending stream's held frame was not flushed");
+
+    start_stream(h, 1);  // new source, same stream id
+    push_frames(h, 1, 5 * GST_SECOND, 10, NEW_PX);
+    drain(h, &old_n, &new_n);
+    fail_unless_equals_int(old_n, 0);  // before: 1 frame of the old source
+    fail_unless(new_n > 0);
+
+    gst_harness_teardown(h);
+}
+GST_END_TEST;
+
+static Suite *dxrate_per_stream_eos_suite(void) {
+    Suite *s = suite_create("dxrate_per_stream_eos");
+    TCase *tc = tcase_create("contract");
+    tcase_set_timeout(tc, 30.0);
+    suite_add_tcase(s, tc);
+    tcase_add_test(tc, per_stream_eos_flushes_and_ends_the_stream);
+    return s;
+}
+
+GST_CHECK_MAIN(dxrate_per_stream_eos);
