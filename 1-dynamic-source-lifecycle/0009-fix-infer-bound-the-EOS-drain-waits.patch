         G_OBJECT_WARN_INVALID_PROPERTY_ID(object, property_id, pspec);
         break;
@@ -202,6 +212,11 @@ static void gst_dxinfer_get_property(GObject *object, guint property_id,
     case PropertyID::PROP_BACKEND:
         g_value_set_enum(value, static_cast<int>(self->_backend_type));
         break;
+    case PropertyID::PROP_EOS_DRAIN_TIMEOUT:
