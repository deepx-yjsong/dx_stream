+        "How long an EOS (global or per-stream) waits for buffers still on the "
+        "device before it is forwarded anyway, in nanoseconds. 0 waits "
+        "indefinitely.",
+        0, G_MAXUINT64, DEFAULT_EOS_DRAIN_TIMEOUT,
+        (GParamFlags)(G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS));
 
     g_object_class_install_properties(gobject_class, static_cast<int>(PropertyID::N_PROPERTIES),
                                       obj_properties.data());
@@ -450,6 +472,24 @@ static void gst_dxinfer_class_init(GstDxInferClass *klass) {
     element_class->change_state = dxinfer_change_state;
 }
 
+/* Wait for `done`, bounded by eos-drain-timeout (0 = unbounded) so a stuck
+ * device cannot pin the streaming thread.  Returns FALSE on expiry. */
+template <typename Pred>
+static gboolean wait_for_drain(GstDxInfer *self,
+                               std::unique_lock<std::mutex> &lock, Pred done) {
+    GST_OBJECT_LOCK(self);
+    const guint64 timeout = self->_eos_drain_timeout;
+    GST_OBJECT_UNLOCK(self);
+
+    if (timeout == 0) {
+        self->_push_ctx.cv.wait(lock, done);
+        return TRUE;
+    }
+    return self->_push_ctx.cv.wait_for(
+               lock, std::chrono::nanoseconds(timeout), done)
+               ? TRUE : FALSE;
+}
+
 gboolean handle_custom_downstream_event(GstDxInfer *self, GstEvent *event) {
     gboolean res = TRUE;
     const GstStructure *s_check = gst_event_get_structure(event);
@@ -473,12 +513,17 @@ gboolean handle_custom_downstream_event(GstDxInfer *self, GstEvent *event) {
             if (!self->_secondary_mode) {
                 std::unique_lock<std::mutex> lock(self->_push_ctx.push_lock);
                 /* find(): operator[] would insert an entry. */
-                self->_push_ctx.cv.wait(lock, [self, stream_id] {
+                const gboolean drained = wait_for_drain(self, lock, [self, stream_id] {
                     std::lock_guard<std::mutex> eos_lk(self->_eos_ctx.eos_lock);
                     auto it = self->_eos_ctx.stream_pending_buffers.find(stream_id);
                     return it == self->_eos_ctx.stream_pending_buffers.end() ||
                            it->second <= 0 || !self->_push_ctx.push_running;
                 });
+                if (!drained) {
+                    GST_WARNING_OBJECT(self,
+                        "Stream [%d]: buffers still on the device after "
+                        "eos-drain-timeout; forwarding EOS anyway", stream_id);
+                }
             }
 
             if (self->_push_ctx.push_running || self->_secondary_mode) {
@@ -521,10 +566,15 @@ static gboolean gst_dxinfer_sink_event(GstPad *pad, GstObject *parent,
             std::unique_lock<std::mutex> lock(self->_push_ctx.push_lock);
             GST_DEBUG_OBJECT(self, "EOS: waiting for %zu queued buffers to drain",
                             self->_push_ctx.push_queue.size());
-            self->_push_ctx.cv.wait(lock, [self] {
+            const gboolean drained = wait_for_drain(self, lock, [self] {
                 return self->_push_ctx.push_queue.empty() ||
                        !self->_push_ctx.push_running;
             });
+            if (!drained) {
+                GST_WARNING_OBJECT(self,
+                    "EOS: %zu buffer(s) still queued after eos-drain-timeout; "
+                    "forwarding EOS anyway", self->_push_ctx.push_queue.size());
+            }
         }
         if (self->_push_ctx.push_running || self->_secondary_mode) {
             GST_DEBUG_OBJECT(self, "EOS: queue drained, forwarding downstream");
@@ -703,6 +753,7 @@ static void gst_dxinfer_init(GstDxInfer *self) {
     self->_secondary_mode = FALSE;
     self->_use_ort = TRUE;
     self->_backend_type = BackendType::AUTO;
+    self->_eos_drain_timeout = DEFAULT_EOS_DRAIN_TIMEOUT;
     new (&self->_backend) std::unique_ptr<IInferBackend>();
     self->_output_tensor_size = 0;
 
