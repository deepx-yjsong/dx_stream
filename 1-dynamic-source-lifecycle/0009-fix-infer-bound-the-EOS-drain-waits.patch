diff --git a/test/base/element/inference/test_dxinfer_eos_drain_timeout.cpp b/test/base/element/inference/test_dxinfer_eos_drain_timeout.cpp
new file mode 100644
index 0000000..25af163
--- /dev/null
+++ b/test/base/element/inference/test_dxinfer_eos_drain_timeout.cpp
@@ -0,0 +1,162 @@
+// dxinfer — eos-drain-timeout bounds both EOS drains
+// A stuck device is simulated by a "running" push thread that never completes.
+// White-box, stub backend, no NPU.
+
+#include <gst/check/gstcheck.h>
+#include <gst/gst.h>
+#include "gst-dxinfer.hpp"
+
+#include <atomic>
+
+class StubInferBackend final : public IInferBackend {
+public:
+    bool Init(const InferBackendOptions&) override { return true; }
+    bool Put(void*, void*) override { return true; }
+    bool Get(dxs::DXTensors&) override { return true; }
+    void Flush() override {}
+    void Reset() override {}
+    size_t GetOutputBufferSize() const override { return 0; }
+    const char* GetName() const override { return "stub"; }
+    bool IsFlushed() const override { return false; }
+};
+
+struct Wedged {
+    GstDxInfer *infer;
+    GstPad *sinkpad;
+
+    // Push thread marked running; nothing ever completes.
+    static Wedged make(guint64 timeout) {
+        Wedged w;
+        w.infer = GST_DXINFER(gst_element_factory_make("dxinfer", nullptr));
+        fail_unless(w.infer != nullptr);
+        w.infer->_backend.reset(new StubInferBackend);
+        g_object_set(w.infer, "eos-drain-timeout", timeout, nullptr);
+        w.sinkpad = gst_element_get_static_pad(GST_ELEMENT(w.infer), "sink");
+        gst_pad_set_active(w.sinkpad, TRUE);
+        w.infer->_push_ctx.push_running = TRUE;
+        return w;
+    }
+
+    void unwedge() {
+        {
+            std::lock_guard<std::mutex> lock(infer->_push_ctx.push_lock);
+            infer->_push_ctx.push_running = FALSE;
+        }
+        infer->_push_ctx.cv.notify_all();
+    }
+
+    void destroy() {
+        unwedge();
+        while (!infer->_push_ctx.push_queue.empty()) {
+            gst_buffer_unref(infer->_push_ctx.push_queue.front().buffer);
+            infer->_push_ctx.push_queue.pop();
+        }
+        gst_pad_set_active(sinkpad, FALSE);
+        gst_object_unref(sinkpad);
+        gst_object_unref(infer);
+    }
+};
+
+static GstEvent *per_stream_eos(int stream_id) {
+    GstEvent *eos = gst_event_new_eos();
+    GstStructure *s = gst_structure_new(
+        "application/x-dx-wrapped-event",
+        "stream-id", G_TYPE_INT, stream_id,
+        "event", GST_TYPE_EVENT, eos, nullptr);
+    gst_event_unref(eos);
+    return gst_event_new_custom(GST_EVENT_CUSTOM_DOWNSTREAM, s);
+}
+
+// Send `ev` from another thread and report whether it returned within `wait`.
+struct Sender {
+    GstPad *pad;
+    GstEvent *ev;
+    std::atomic<bool> returned{false};
+
+    static gpointer run(gpointer data) {
+        auto *s = static_cast<Sender *>(data);
+        gst_pad_send_event(s->pad, s->ev);
+        s->returned = true;
+        return nullptr;
+    }
+};
+
+static bool returns_within(Sender &s, gulong wait_ms) {
+    for (gulong t = 0; t < wait_ms && !s.returned; t += 10)
+        g_usleep(10 * 1000);
+    return s.returned;
+}
+
+GST_START_TEST(per_stream_eos_drain_is_bounded) {
+    auto w = Wedged::make(200 * GST_MSECOND);
+    w.infer->_eos_ctx.stream_pending_buffers[8] = 1;  // never completes
+
+    Sender s{w.sinkpad, per_stream_eos(8)};
+    GThread *th = g_thread_new("send", Sender::run, &s);
+    bool ok = returns_within(s, 2000);
+    if (!ok) w.unwedge();  // let the thread finish so the test can report
+    g_thread_join(th);
+
+    fail_unless(ok, "per-stream EOS still blocked 2 s after a 200 ms "
+                    "eos-drain-timeout: a wedged device pins the thread");
+    w.destroy();
+}
+GST_END_TEST;
+
+GST_START_TEST(global_eos_drain_is_bounded) {
+    auto w = Wedged::make(200 * GST_MSECOND);
+    GstBuffer *stuck = gst_buffer_new();
+    w.infer->_push_ctx.push_queue.push({true, stuck});  // never completes
+
+    Sender s{w.sinkpad, gst_event_new_eos()};
+    GThread *th = g_thread_new("send", Sender::run, &s);
+    bool ok = returns_within(s, 2000);
+    if (!ok) w.unwedge();
+    g_thread_join(th);
+
+    fail_unless(ok, "EOS still blocked 2 s after a 200 ms eos-drain-timeout: "
+                    "a wedged device keeps the pipeline from shutting down");
+    w.destroy();
+}
+GST_END_TEST;
+
+// 0 keeps the previous unbounded wait.
+GST_START_TEST(zero_waits_until_drained) {
+    auto w = Wedged::make(0);
+    w.infer->_eos_ctx.stream_pending_buffers[9] = 1;
+
+    Sender s{w.sinkpad, per_stream_eos(9)};
+    GThread *th = g_thread_new("send", Sender::run, &s);
+    bool early = returns_within(s, 500);
+    w.unwedge();  // the drain can now complete (push thread stopped)
+    bool after = returns_within(s, 2000);
+    g_thread_join(th);
+
+    fail_if(early, "eos-drain-timeout=0 must wait for the drain");
+    fail_unless(after, "EOS did not return once the drain could complete");
+    w.destroy();
+}
+GST_END_TEST;
+
+GST_START_TEST(default_is_bounded) {
+    GstElement *e = gst_element_factory_make("dxinfer", nullptr);
+    guint64 t = 0;
+    g_object_get(e, "eos-drain-timeout", &t, nullptr);
+    fail_unless(t > 0, "the default must be bounded");
+    gst_object_unref(e);
+}
+GST_END_TEST;
+
+static Suite *dxinfer_eos_drain_timeout_suite(void) {
+    Suite *s = suite_create("dxinfer_eos_drain_timeout");
+    TCase *tc = tcase_create("contract");
+    tcase_set_timeout(tc, 30.0);
+    suite_add_tcase(s, tc);
+    tcase_add_test(tc, per_stream_eos_drain_is_bounded);
+    tcase_add_test(tc, global_eos_drain_is_bounded);
+    tcase_add_test(tc, zero_waits_until_drained);
+    tcase_add_test(tc, default_is_bounded);
+    return s;
+}
+
+GST_CHECK_MAIN(dxinfer_eos_drain_timeout);
