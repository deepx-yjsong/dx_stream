+++ b/dx_stream/custom_library/message_convert_library/dx_msgconvl/tests/test_protobuf_convert.cpp
@@ -0,0 +1,75 @@
+#include "dx_msgconvl_priv.hpp"
+#include "dx_frame.pb.h"
+#include "gstdxstream/gst-dxframemeta.hpp"
+#include "gstdxstream/gst-dxobjectmeta.hpp"
+
+#include <glib.h>
+#include <cassert>
+#include <cstdio>
+
+static dxstream::SensorFrame convert(GstDxMsgMetaInfo *info) {
+    DxMsgContext ctx{};
+    size_t size = 0;
+    void *buf = dxpayload_convert_to_protobuf(&ctx, info, &size);
+    assert(buf != nullptr);
+    dxstream::SensorFrame frame;
+    bool ok = frame.ParseFromArray(buf, (int)size);
+    assert(ok);
+    g_free(buf);
+    return frame;
+}
+
+int main() {
+    DXObjectMeta obj{};
+    obj._label = 1;
+    obj._track_id = 42;
+    obj._confidence = 0.87f;
+    obj._label_name = "person";
+    obj._box = {300.f, 400.f, 500.f, 600.f};
+
+    DXFrameMeta fm{};
+    fm._stream_id = 0;
+    fm._sensor_id = "cam01";
+    fm._width = 1920;
+    fm._height = 1080;
+    fm._object_meta_list.push_back(&obj);
+
+    GstDxMsgMetaInfo info{};
+    info._frame_meta = &fm;
+    info._seq_id = 123;
+    info._payload_type = DX_PAYLOAD_TYPE_PROTOBUF;
+    info._node_id = "node-01";
+    info._pts = 1234567890;
+    info._capture_time = 1790000000 * GST_SECOND + 456789012;
+
+    dxstream::SensorFrame frame = convert(&info);
+    assert(frame.sensor_id() == "cam01");
+    assert(frame.node_id() == "node-01");
+    assert(frame.stream_id() == 0);
+    assert(frame.seq_id() == 123u);
+    assert(frame.width() == 1920);
+    assert(frame.height() == 1080);
+    assert(frame.pts_ns() == 1234567890);
+    assert(frame.has_capture_time());
+    assert(frame.capture_time().seconds() == 1790000000);
+    assert(frame.capture_time().nanos() == 456789012);
+    assert(frame.objects_size() == 1);
+    const dxstream::Detection &d = frame.objects(0);
+    assert(d.label_id() == 1);
+    assert(d.track_id() == 42);
+    assert(d.name() == "person");
+    assert(d.box().start_x() == 300.f);
+    assert(d.box().start_y() == 400.f);
+    assert(d.box().end_x() == 500.f);
+    assert(d.box().end_y() == 600.f);
+
+    // Unknown times: no capture_time, PTS -1.
+    info._pts = GST_CLOCK_TIME_NONE;
+    info._capture_time = GST_CLOCK_TIME_NONE;
+    frame = convert(&info);
+    assert(!frame.has_capture_time());
+    assert(frame.pts_ns() == -1);
+
+    std::printf("PASS\n");
+    return 0;
+}
