+/* UTC time as RFC 3339 with nanoseconds, the proto3 JSON form of
+ * google.protobuf.Timestamp. */
+static gchar *format_rfc3339(GstClockTime unix_ns) {
+    GDateTime *dt = g_date_time_new_from_unix_utc((gint64)(unix_ns / GST_SECOND));
+    gchar *date = g_date_time_format(dt, "%Y-%m-%dT%H:%M:%S");
+    gchar *out = g_strdup_printf("%s.%09" G_GUINT64_FORMAT "Z", date,
+                                 (guint64)(unix_ns % GST_SECOND));
+    g_free(date);
+    g_date_time_unref(dt);
+    return out;
+}
