diff --git a/test/base/element/messaging/test_dxmsgconv_identity.cpp b/test/base/element/messaging/test_dxmsgconv_identity.cpp
new file mode 100644
index 0000000..16de9b1
--- /dev/null
+++ b/test/base/element/messaging/test_dxmsgconv_identity.cpp
@@ -0,0 +1,158 @@
+// dxmsgconv — source identity and capture time in each message
+//   sensorId / nodeId: DXFrameMeta._sensor_id and the "node-id" property
+//   message key: the source's sensor id, on GstDxMsgMeta
+//   captureTime: RFC 3339 UTC from a timestamp/x-ntp or timestamp/x-unix
+//                reference; other references are not wall-clock time
+
+#include <gst/check/gstcheck.h>
+#include <gst/check/gstharness.h>
+#include <gst/gst.h>
+#include "harness_helpers.hpp"
+#include "meta_helpers.hpp"
+#include "npu_env.hpp"
+#include <cstring>
+#include <string>
+
+using namespace dxtest;
+
+static const char *CAPS_STR =
+    "video/x-raw,format=RGB,width=4,height=4,framerate=30/1";
+static std::string MSGCONV_LIB_PATH() {
+    return dxtest::resolve_lib_path("libdx_msgconvl.so");
+}
+#define MSGCONV_LIB (MSGCONV_LIB_PATH().c_str())
+
+static GstBuffer *make_buf_with_sensor(GstClockTime pts, int stream_id,
+                                       const char *sensor_id) {
+    gsize sz = 4 * 4 * 3;
+    GstBuffer *b = gst_buffer_new_allocate(nullptr, sz, nullptr);
+    GstMapInfo m; gst_buffer_map(b, &m, GST_MAP_WRITE);
+    std::memset(m.data, 0x80, sz); gst_buffer_unmap(b, &m);
+    GST_BUFFER_PTS(b) = pts;
+    GST_BUFFER_DURATION(b) = GST_SECOND / 30;
+    DXFrameMeta *fm = make_frame_meta(b, stream_id, 4, 4);
+    fm->_sensor_id = sensor_id;
+    add_object_to_frame(fm, 1, 0.9f, 0, 0, 1, 1);
+    return b;
+}
+
+// Extract string value of "<key>":"<value>" from JSON (first match).
+static std::string find_string_field(const std::string &json, const char *key) {
+    std::string needle = std::string("\"") + key + "\"";
+    auto p = json.find(needle);
+    if (p == std::string::npos) return "";
+    p = json.find(':', p);
+    if (p == std::string::npos) return "";
+    p++;
+    while (p < json.size() && (json[p] == ' ' || json[p] == '\t')) p++;
+    if (p >= json.size() || json[p] != '"') return "";
+    p++;
+    std::string out;
+    while (p < json.size() && json[p] != '"') { out += json[p]; p++; }
+    return out;
+}
+
+struct Converted {
+    std::string json;
+    std::string key;
+};
+
+static Converted convert_one(GstBuffer *in, const char *node_id = nullptr) {
+    GstElement *e = gst_element_factory_make("dxmsgconv", nullptr);
+    g_object_set(e, "library-file-path", MSGCONV_LIB, nullptr);
+    if (node_id)
+        g_object_set(e, "node-id", node_id, nullptr);
+    GstHarness *h = gst_harness_new_with_element(e, "sink", "src");
+    fail_unless(h != nullptr);
+    gst_harness_set_src_caps_str(h, CAPS_STR);
+    fail_unless_equals_int(gst_harness_push(h, in), GST_FLOW_OK);
+
+    GstBuffer *out = gst_harness_pull(h);
+    fail_unless(out != nullptr);
+    GstDxMsgMeta *mm = dx_get_msg_meta(out);
+    fail_unless(mm != nullptr, "buffer missing DxMsgMeta");
+    DxMsgPayload *pl = (DxMsgPayload *)mm->_payload;
+    fail_unless(pl && pl->_data && pl->_size > 0);
+    Converted r{std::string((const char *)pl->_data, pl->_size),
+                mm->_key ? mm->_key : ""};
+
+    gst_buffer_unref(out);
+    gst_harness_teardown(h);
+    gst_object_unref(e);
+    return r;
+}
+
+static void add_reference(GstBuffer *b, const char *caps, GstClockTime t) {
+    GstCaps *c = gst_caps_from_string(caps);
+    gst_buffer_add_reference_timestamp_meta(b, c, t, GST_CLOCK_TIME_NONE);
+    gst_caps_unref(c);
+}
+
+/* 2026-09-29T01:02:03.456789012Z */
+static const GstClockTime kUnix = G_GUINT64_CONSTANT(1790643723) * GST_SECOND + 456789012;
+static const char *kRfc3339 = "2026-09-29T01:02:03.456789012Z";
+static const GstClockTime kNtpOffset = G_GUINT64_CONSTANT(2208988800) * GST_SECOND;
+
+GST_START_TEST(ID_msgconv_sensor_and_node_id) {
+    Converted r = convert_one(make_buf_with_sensor(0, 0, "cam01"), "node-01");
+    std::string sensor = find_string_field(r.json, "sensorId");
+    std::string node = find_string_field(r.json, "nodeId");
+    fail_unless_equals_string(sensor.c_str(), "cam01");
+    fail_unless_equals_string(node.c_str(), "node-01");
+}
+GST_END_TEST;
+
+GST_START_TEST(ID_msgconv_key_is_sensor_id) {
+    Converted r = convert_one(make_buf_with_sensor(0, 0, "cam01"));
+    fail_unless_equals_string(r.key.c_str(), "cam01");
+
+    r = convert_one(make_buf_with_sensor(0, 0, ""));
+    fail_unless(r.key.empty(), "no sensor id must mean no key, got '%s'",
+                r.key.c_str());
+    fail_unless(r.json.find("sensorId") == std::string::npos);
+}
+GST_END_TEST;
+
+GST_START_TEST(ID_msgconv_capture_time_from_ntp) {
+    GstBuffer *b = make_buf_with_sensor(0, 0, "cam01");
+    add_reference(b, "timestamp/x-ntp", kUnix + kNtpOffset);
+    Converted r = convert_one(b);
+    std::string t = find_string_field(r.json, "captureTime");
+    fail_unless_equals_string(t.c_str(), kRfc3339);
+}
+GST_END_TEST;
+
+GST_START_TEST(ID_msgconv_capture_time_from_unix) {
+    GstBuffer *b = make_buf_with_sensor(0, 0, "cam01");
+    add_reference(b, "timestamp/x-unix", kUnix);
+    Converted r = convert_one(b);
+    std::string t = find_string_field(r.json, "captureTime");
+    fail_unless_equals_string(t.c_str(), kRfc3339);
+}
+GST_END_TEST;
+
+GST_START_TEST(ID_msgconv_capture_time_ignores_other_references) {
+    GstBuffer *b = make_buf_with_sensor(0, 0, "cam01");
+    // Large enough that misreading it as NTP would yield a valid time.
+    add_reference(b, "timestamp/x-ptp", kUnix + kNtpOffset);
+    Converted r = convert_one(b);
+    fail_unless(r.json.find("captureTime") == std::string::npos,
+                "a non-UTC reference must not become captureTime: %s",
+                r.json.c_str());
+}
+GST_END_TEST;
+
+static Suite *dxmsgconv_identity_suite(void) {
+    Suite *s = suite_create("dxmsgconv_identity");
+    TCase *tc = tcase_create("identity");
+    tcase_set_timeout(tc, 15.0);
+    suite_add_tcase(s, tc);
+    tcase_add_test(tc, ID_msgconv_sensor_and_node_id);
+    tcase_add_test(tc, ID_msgconv_key_is_sensor_id);
+    tcase_add_test(tc, ID_msgconv_capture_time_from_ntp);
+    tcase_add_test(tc, ID_msgconv_capture_time_from_unix);
+    tcase_add_test(tc, ID_msgconv_capture_time_ignores_other_references);
+    return s;
+}
+
+GST_CHECK_MAIN(dxmsgconv_identity);
