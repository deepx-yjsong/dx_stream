index 0000000..436a4af
--- /dev/null
+++ b/dx_stream/custom_library/message_convert_library/dx_msgconvl/proto/dx_frame.proto
@@ -0,0 +1,43 @@
+syntax = "proto3";
+
+package dxstream;
+
+import "google/protobuf/timestamp.proto";
+
+message BBox {
+  float start_x = 1;
+  float start_y = 2;
+  float end_x = 3;
+  float end_y = 4;
+}
+
+message Keypoint {
+  float x = 1;
+  float y = 2;
+  float score = 3;
+}
+
+message Detection {
+  int32 label_id = 1;
+  int32 track_id = 2;
+  float confidence = 3;
+  string name = 4;
+  BBox box = 5;
+  repeated Keypoint keypoints = 6;  // pose models only
+}
+
+// One frame's inference result: the protobuf form of the JSON payload.
+message SensorFrame {
+  string sensor_id = 1;   // dxinputselector pad "sensor-id"; empty if unset
+  string node_id = 2;     // dxmsgconv "node-id"; empty if unset
+  int32 stream_id = 3;    // dxinputselector pad index; reused by later sources
+  uint64 seq_id = 4;      // per-stream message counter
+  int32 width = 5;
+  int32 height = 6;
+  int64 pts_ns = 7;       // buffer PTS in ns; -1 if the buffer had none
+  reserved 8;             // retired; never reuse
+  repeated Detection objects = 9;
+  // Capture time (UTC) from the source's timestamp/x-ntp or timestamp/x-unix
+  // reference; unset if the source provides none.
+  google.protobuf.Timestamp capture_time = 10;
+}
