diff --git a/test/base/element/inference/test_dxinfer_stats.cpp b/test/base/element/inference/test_dxinfer_stats.cpp
new file mode 100644
index 0000000..a322721
--- /dev/null
+++ b/test/base/element/inference/test_dxinfer_stats.cpp
@@ -0,0 +1,136 @@
+// dxinfer — `stats` counts every buffer chain() drops without an error,
+// by reason.  White-box, stub backend, no NPU.
+
+#include <gst/check/gstcheck.h>
+#include <gst/gst.h>
+#include "gst-dxinfer.hpp"
+#include "meta_helpers.hpp"
+
+class StubInferBackend final : public IInferBackend {
+public:
+    bool Init(const InferBackendOptions&) override { return true; }
+    bool Put(void*, void*) override { return true; }
+    bool Get(dxs::DXTensors&) override { return true; }
+    void Flush() override {}
+    void Reset() override {}
+    size_t GetOutputBufferSize() const override { return 0; }
+    const char* GetName() const override { return "stub"; }
+    bool IsFlushed() const override { return false; }
+};
+
+struct InferUnderTest {
+    GstDxInfer *infer;
+    GstPad *sinkpad;
+    GstPad *srcpad;
+
+    static InferUnderTest make() {
+        InferUnderTest t;
+        t.infer = GST_DXINFER(gst_element_factory_make("dxinfer", nullptr));
+        fail_unless(t.infer != nullptr);
+        t.infer->_backend.reset(new StubInferBackend);
+        t.sinkpad = gst_element_get_static_pad(GST_ELEMENT(t.infer), "sink");
+        t.srcpad = gst_element_get_static_pad(GST_ELEMENT(t.infer), "src");
+        gst_pad_set_active(t.sinkpad, TRUE);
+        gst_pad_set_active(t.srcpad, TRUE);  // QoS arrives on the srcpad
+        return t;
+    }
+
+    GstFlowReturn chain(GstClockTime pts, int stream_id = -1) {
+        GstBuffer *buf = gst_buffer_new();
+        GST_BUFFER_PTS(buf) = pts;
+        if (stream_id >= 0)
+            dxtest::make_frame_meta(buf, stream_id, 4, 4);
+        return GST_PAD_CHAINFUNC(sinkpad)(sinkpad, GST_OBJECT(infer), buf);
+    }
+
+    void qos(GstQOSType type, GstClockTimeDiff diff) {
+        gst_pad_send_event(srcpad, gst_event_new_qos(type, 1.0, diff, 0));
+    }
+
+    guint64 stat(const char *field) {
+        GstStructure *s = nullptr;
+        g_object_get(infer, "stats", &s, nullptr);
+        fail_unless(s != nullptr, "dxinfer has no stats");
+        fail_unless(gst_structure_has_name(s, "application/x-dxinfer-stats"));
+        guint64 v = 0;
+        fail_unless(gst_structure_get_uint64(s, field, &v),
+                    "stats has no guint64 field %s", field);
+        gst_structure_free(s);
+        return v;
+    }
+
+    void destroy() {
+        gst_pad_set_active(srcpad, FALSE);
+        gst_pad_set_active(sinkpad, FALSE);
+        gst_object_unref(srcpad);
+        gst_object_unref(sinkpad);
+        gst_object_unref(infer);
+    }
+};
+
+GST_START_TEST(starts_at_zero) {
+    auto t = InferUnderTest::make();
+    for (const char *f : {"dropped-qos", "dropped-throttled", "dropped-no-meta",
+                          "dropped-after-eos"})
+        fail_unless_equals_uint64(t.stat(f), 0);
+    t.destroy();
+}
+GST_END_TEST;
+
+GST_START_TEST(counts_buffers_without_frame_meta) {
+    auto t = InferUnderTest::make();
+    for (int i = 0; i < 3; i++)
+        fail_unless_equals_int(t.chain(i * GST_MSECOND), GST_FLOW_OK);
+    fail_unless_equals_uint64(t.stat("dropped-no-meta"), 3);
+    t.destroy();
+}
+GST_END_TEST;
+
+GST_START_TEST(counts_buffers_of_an_ended_stream) {
+    auto t = InferUnderTest::make();
+    {
+        std::lock_guard<std::mutex> lock(t.infer->_eos_ctx.eos_lock);
+        t.infer->_eos_ctx.stream_eos_arrived.insert(5);
+    }
+    fail_unless_equals_int(t.chain(0, 5), GST_FLOW_OK);
+    fail_unless_equals_int(t.chain(GST_MSECOND, 5), GST_FLOW_OK);
+    fail_unless_equals_uint64(t.stat("dropped-after-eos"), 2);
+    fail_unless_equals_uint64(t.stat("dropped-no-meta"), 0);
+    t.destroy();
+}
+GST_END_TEST;
+
+GST_START_TEST(counts_qos_underflow_drops) {
+    auto t = InferUnderTest::make();
+    t.qos(GST_QOS_TYPE_UNDERFLOW, GST_SECOND);  // earliest = 1 s
+    fail_unless_equals_int(t.chain(100 * GST_MSECOND), GST_FLOW_OK);
+    fail_unless_equals_uint64(t.stat("dropped-qos"), 1);
+    fail_unless_equals_uint64(t.stat("dropped-no-meta"), 0);
+    t.destroy();
+}
+GST_END_TEST;
+
+GST_START_TEST(counts_qos_throttle_drops) {
+    auto t = InferUnderTest::make();
+    t.qos(GST_QOS_TYPE_THROTTLE, GST_SECOND);  // one buffer per second
+    fail_unless_equals_int(t.chain(0), GST_FLOW_OK);
+    fail_unless_equals_int(t.chain(10 * GST_MSECOND), GST_FLOW_OK);
+    fail_unless_equals_uint64(t.stat("dropped-throttled"), 2);
+    t.destroy();
+}
+GST_END_TEST;
+
+static Suite *dxinfer_stats_suite(void) {
+    Suite *s = suite_create("dxinfer_stats");
+    TCase *tc = tcase_create("contract");
+    tcase_set_timeout(tc, 30.0);
+    suite_add_tcase(s, tc);
+    tcase_add_test(tc, starts_at_zero);
+    tcase_add_test(tc, counts_buffers_without_frame_meta);
